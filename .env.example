# Path to the Laravel log file written by the "log" mail driver
LOG_PATH=/path/to/your-laravel-app/storage/logs/laravel.log

# Port the inspector listens on (optional, defaults to 4321)
PORT=4321

# Laravel app root used to find mail templates (optional, derived from LOG_PATH)
# LARAVEL_PATH=/path/to/your-laravel-app

# Set to false to not open the browser automatically on start (optional)
# OPEN=false
